{
  "name": "@onchaintradedfunds/launch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "deploy:build": "node scripts/migrate-production.mjs && next build",
    "dev": "next dev --turbopack -p 3001",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@onchaintradedfunds/brand": "workspace:*",
    "drizzle-orm": "0.44.5",
    "lucide-react": "0.468.0",
    "next": "15.5.22",
    "postgres": "3.4.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "redis": "5.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "24.1.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "drizzle-kit": "0.31.4",
    "eslint": "9.32.0",
    "eslint-config-next": "15.5.22",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
