{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://platform.twitter.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://pbs.twimg.com https://abs.twimg.com https://cdn.robinhood.com; connect-src 'self' https://api.x.com https://api.robinhood.com https://challenges.cloudflare.com https://syndication.twitter.com https://cdn.syndication.twimg.com; frame-src https://challenges.cloudflare.com https://platform.twitter.com https://syndication.twitter.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://x.com"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/v1/admin/proposals/[id]/moderate",
      "regex": "^/api/v1/admin/proposals/([^/]+?)/moderate(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/admin/proposals/(?<nxtPid>[^/]+?)/moderate(?:/)?$"
    },
    {
      "page": "/api/v1/proposals/[idOrSlug]",
      "regex": "^/api/v1/proposals/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPidOrSlug": "nxtPidOrSlug"
      },
      "namedRegex": "^/api/v1/proposals/(?<nxtPidOrSlug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/v1/submissions/[id]/publish",
      "regex": "^/api/v1/submissions/([^/]+?)/publish(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/v1/submissions/(?<nxtPid>[^/]+?)/publish(?:/)?$"
    },
    {
      "page": "/otfs/[slug]",
      "regex": "^/otfs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/otfs/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/assets",
      "regex": "^/assets(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/assets(?:/)?$"
    },
    {
      "page": "/leaderboard",
      "regex": "^/leaderboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/leaderboard(?:/)?$"
    },
    {
      "page": "/me",
      "regex": "^/me(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/me(?:/)?$"
    },
    {
      "page": "/points",
      "regex": "^/points(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/points(?:/)?$"
    },
    {
      "page": "/privacy",
      "regex": "^/privacy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy(?:/)?$"
    },
    {
      "page": "/rules",
      "regex": "^/rules(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/rules(?:/)?$"
    },
    {
      "page": "/submit",
      "regex": "^/submit(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/submit(?:/)?$"
    },
    {
      "page": "/terms",
      "regex": "^/terms(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/terms(?:/)?$"
    },
    {
      "page": "/vote",
      "regex": "^/vote(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/vote(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}