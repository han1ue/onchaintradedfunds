{
  "name": "onchaintradedfunds",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "contracts:solc": "node scripts/compile-contracts.mjs",
    "contracts:deploy:robinhood-testnet": "node scripts/deploy-robinhood-testnet.mjs",
    "contracts:configure:robinhood-testnet-mocks": "node scripts/configure-robinhood-testnet-mocks.mjs",
    "contracts:configure:robinhood-testnet-synthra": "node scripts/configure-robinhood-testnet-synthra.mjs",
    "contracts:create-sample:robinhood-testnet": "node scripts/create-robinhood-testnet-sample.mjs",
    "contracts:walk:robinhood-testnet-mocks": "node scripts/walk-robinhood-testnet-mock-prices.mjs",
    "contracts:solhint": "solhint \"contracts/src/**/*.sol\" --max-warnings 0",
    "contracts:security": "node scripts/check-contract-security.mjs",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "build": "corepack pnpm -r build"
  },
  "devDependencies": {
    "solc": "0.8.30",
    "solhint": "6.2.3"
  }
}
