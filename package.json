{
  "name": "onchaintradedfunds",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "mainnet:prepare": "node scripts/prepare-mainnet.mjs",
    "mainnet:check-services": "node --env-file-if-exists=app/.env.local scripts/check-mainnet-services.mjs",
    "contracts:solc": "node scripts/compile-contracts.mjs",
    "contracts:abi": "node scripts/generate-contract-abis.mjs",
    "contracts:deploy:robinhood-testnet": "node --env-file-if-exists=app/.env.local scripts/deploy-robinhood-testnet.mjs",
    "oracle:verify:robinhood-mainnet": "node scripts/verify-robinhood-mainnet-oracle.mjs",
    "rewards:tree": "node scripts/build-merkle-rewards.mjs",
    "docs:dev": "corepack pnpm --filter @onchaintradedfunds/docs dev",
    "docs:build": "corepack pnpm --filter @onchaintradedfunds/docs build",
    "contracts:solhint": "solhint \"contracts/src/**/*.sol\" --max-warnings 0",
    "contracts:security": "node scripts/check-contract-security.mjs",
    "contracts:validate:mainnet-routing": "node scripts/verify-mainnet-routing.mjs",
    "contracts:seed:testnet-v3": "node --env-file-if-exists=app/.env.local scripts/seed-uniswap-v3-testnet.mjs",
    "contracts:coverage": "node scripts/check-contract-coverage.mjs",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "build": "corepack pnpm -r build",
    "registry:migrate": "node --env-file-if-exists=app/.env.local app/scripts/database.mjs migrate",
    "registry:seed": "node --env-file-if-exists=app/.env.local app/scripts/database.mjs seed",
    "contracts:verify:testnet-routing": "node --env-file-if-exists=app/.env.local scripts/verify-universal-routing-testnet.mjs",
    "contracts:deploy:testnet-routing": "node --env-file-if-exists=app/.env.local scripts/deploy-universal-routing-testnet.mjs"
  },
  "devDependencies": {
    "@openzeppelin/merkle-tree": "1.0.8",
    "@uniswap/permit2": "github:Uniswap/permit2#cc56ad0f3439c502c246fc5cfcc3db92bb8b7219",
    "@uniswap/universal-router": "github:Uniswap/universal-router#999d561c3ad58fb5cab91b602911f3c75591a9c7",
    "@uniswap/v2-core": "1.0.1",
    "@uniswap/v3-core": "1.0.1",
    "@uniswap/v3-periphery": "1.4.4",
    "@uniswap/v4-core": "github:Uniswap/v4-core#59d3ecf53afa9264a16bba0e38f4c5d2231f80bc",
    "@uniswap/v4-periphery": "github:Uniswap/v4-periphery#3231810e39b8c4d569b9d66907fa4ef8cd2cec22",
    "forge-std": "github:foundry-rs/forge-std#1de6eecf821de7fe2c908cc48d3ab3dced20717f",
    "openzeppelin-contracts": "npm:@openzeppelin/contracts@5.0.2",
    "slopless": "^0.2.36",
    "solc": "0.8.26",
    "solhint": "6.2.4",
    "solmate": "github:transmissions11/solmate#4b47a19038b798b4a33d9749d25e570443520647",
    "universal-router-solmate": "github:transmissions11/solmate#8d910d876f51c3b2585c9109409d601f600e68e1",
    "universal-router-v3-periphery": "github:Uniswap/v3-periphery#b325bb0905d922ae61fcc7df85ee802e8df5e96c"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1"
  }
}
