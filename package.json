{
  "name": "onchaintradedfunds",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "contracts:solc": "node scripts/compile-contracts.mjs",
    "contracts:abi": "node scripts/generate-contract-abis.mjs",
    "contracts:deploy:robinhood-testnet": "node scripts/deploy-robinhood-testnet.mjs",
    "rewards:tree": "node scripts/build-merkle-rewards.mjs",
    "launch:dev": "corepack pnpm --filter @onchaintradedfunds/launch dev",
    "launch:build": "corepack pnpm --filter @onchaintradedfunds/launch build",
    "launch:test": "corepack pnpm --filter @onchaintradedfunds/launch test",
    "docs:dev": "corepack pnpm --filter @onchaintradedfunds/docs dev",
    "docs:build": "corepack pnpm --filter @onchaintradedfunds/docs build",
    "contracts:solhint": "solhint \"contracts/src/**/*.sol\" --max-warnings 0",
    "contracts:security": "node scripts/check-contract-security.mjs",
    "contracts:coverage": "node scripts/check-contract-coverage.mjs",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "build": "corepack pnpm -r build"
  },
  "devDependencies": {
    "@openzeppelin/merkle-tree": "1.0.8",
    "solc": "0.8.36",
    "solhint": "6.2.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1"
  }
}
