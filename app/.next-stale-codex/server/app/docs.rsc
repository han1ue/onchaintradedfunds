 caps, approved assets, weight bounds, and cooldown are checked."}]]}]]}],["$","li",null,{"children":[["$","span",null,{"children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fund"}],["$","p",null,{"children":"The exact initial constituent balances move into the new vault."}]]}]]}],["$","li",null,{"children":[["$","span",null,{"children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Initialize"}],["$","p",null,{"children":"Rules, completed strategy version zero, its target snapshot, and the creation-time cooldown baseline are stored."}]]}]]}],["$","li",null,{"children":[["$","span",null,{"children":"04"}],["$","div",null,{"children":[["$","strong",null,{"children":"Issue"}],["$","p",null,{"children":"Initial vault shares are minted to the manager."}]]}]]}]]}]]}]
13:["$","section",null,{"className":"docsSection","id":"deposits","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-down-to-line","children":[["$","path","1cwfxf",{"d":"M12 17V3"}],["$","path","12ii2o",{"d":"m6 11 6 6 6-6"}],["$","path","150jfl",{"d":"M19 21H5"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Proportional entry"}],["$","h2",null,{"children":"Deposits"}]]}]]}],["$","p",null,{"children":"New shares require a proportional deposit of every current constituent. Required inputs round up to protect existing holders. Before depositing, the holder approves each constituent for the selected vault. Deposits transfer the basket directly into that vault and mint the corresponding vault shares."}],["$","div",null,{"className":"docsNotice","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":17,"height":17,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-landmark","children":[["$","line","j8o0r",{"x1":"3","x2":"21","y1":"22","y2":"22"}],["$","line","10tf0k",{"x1":"6","x2":"6","y1":"18","y2":"11"}],["$","line","54lgf6",{"x1":"10","x2":"10","y1":"18","y2":"11"}],["$","line","380y",{"x1":"14","x2":"14","y1":"18","y2":"11"}],["$","line","1kevvc",{"x1":"18","x2":"18","y1":"18","y2":"11"}],["$","polygon","jkujk7",{"points":"12 2 20 7 4 7"}],"$undefined"]}],["$","div",null,{"children":[["$","strong",null,{"children":"Two USDG entry routes"}],["$","span",null,{"children":"The app can buy existing shares from an optional OTF/USDG market, or use the settlement router to buy the exact constituent basket and mint new shares atomically. The manager creates and seeds the direct share market from their own wallet. Either route can price above or below the Chainlink-priced OTF value."}]]}]]}],["$","pre",null,{"children":["$","code",null,{"children":"enterWithSettlement(\n  vault,\n  shares,\n  receiver,\n  maxSettlementIn,\n  deadline,\n  swaps\n)"}]}]]}]
14:["$","section",null,{"className":"docsSection","id":"redemptions","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-up-from-line","children":[["$","path","kcunyi",{"d":"m18 9-6-6-6 6"}],["$","path","7cf3v8",{"d":"M12 3v14"}],["$","path","11awu3",{"d":"M5 21h14"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Proportional exit"}],["$","h2",null,{"children":"Redemptions"}]]}]]}],["$","p",null,{"children":"Redemptions burn vault shares and return a proportional amount of every current constituent. Outputs round down to protect remaining holders. Redemptions do not reset the rebalance cooldown and remain available when oracle-dependent management actions are unavailable."}],["$","div",null,{"className":"docsNotice","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":17,"height":17,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-landmark","children":[["$","line","j8o0r",{"x1":"3","x2":"21","y1":"22","y2":"22"}],["$","line","10tf0k",{"x1":"6","x2":"6","y1":"18","y2":"11"}],["$","line","54lgf6",{"x1":"10","x2":"10","y1":"18","y2":"11"}],["$","line","380y",{"x1":"14","x2":"14","y1":"18","y2":"11"}],["$","line","1kevvc",{"x1":"18","x2":"18","y1":"18","y2":"11"}],["$","polygon","jkujk7",{"points":"12 2 20 7 4 7"}],"$undefined"]}],["$","div",null,{"children":[["$","strong",null,{"children":"Two USDG exit routes"}],["$","span",null,{"children":"The app can sell existing shares into the optional OTF/USDG market, or use the settlement router to redeem and sell every constituent through approved adapters. The latter path enforces per-leg and aggregate minimums and reverts the share burn and all swaps atomically if any leg fails."}]]}]]}]]}]
15:["$","section",null,{"className":"docsSection","id":"portfolio-structure","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-coins","children":[["$","circle","3yglwk",{"cx":"8","cy":"8","r":"6"}],["$","path","t5s6rm",{"d":"M18.09 10.37A6 6 0 1 1 10.34 18"}],["$","path","1obek4",{"d":"M7 6h1v4"}],["$","path","1rbuyh",{"d":"m16.71 13.88.7.71-2.82 2.82"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"The live basket"}],["$","h2",null,{"children":"Constituents and weights"}]]}]]}],["$","p",null,{"children":"A portfolio stores its tracked asset addresses and target weights. Actual weights are derived from current balances and fresh oracle prices. Portfolio reads expose the targets, actual weights, token balances, prices, and feed freshness independently. Strategy history permanently pairs each activated target snapshot with the manager's locked rationale and later records when the portfolio reaches its bands."}]]}]
16:["$","section",null,{"className":"docsSection","id":"valuation","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chart-pie","children":[["$","path","pzmjnu",{"d":"M21 12c.552 0 1.005-.449.95-.998a10 10 0 0 0-8.953-8.951c-.55-.055-.998.398-.998.95v8a1 1 0 0 0 1 1z"}],["$","path","k2fpak",{"d":"M21.21 15.89A10 10 0 1 1 8 2.83"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Oracle-denominated accounting"}],["$","h2",null,{"children":"Valuation and NAV"}]]}]]}],["$","p",null,{"children":"NAV is the sum of every constituent's oracle-valued balance. NAV per share divides that value by the fee-adjusted share supply. Valuation-dependent actions require a positive answer from an approved feed within the vault's freshness bound."}],["$","pre",null,{"children":["$","code",null,{"children":"asset value = token balance x oracle price\nportfolio NAV = sum(asset values)\nactual weight = asset value / portfolio NAV\nNAV per share = portfolio NAV / total share supply"}]}]]}]
17:["$","section",null,{"className":"docsSection","id":"target-proposals","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-braces","children":[["$","path","ezmyqa",{"d":"M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"}],["$","path","e1hn23",{"d":"M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Strategic changes"}],["$","h2",null,{"children":"Target proposals"}]]}]]}],["$","p",null,{"children":["Every target proposal requires a non-empty rationale and a real constituent or weight change. The application submits both atomically through ",["$","code",null,{"children":"proposeStrategy"}],". Draft ERC-7621 callers may stage a rationale and then call the standard",["$","code",null,{"children":"rebalance"}]," selector. The locked proposal leaves the active basket unchanged for 48 hours, giving holders time to redeem. Activation revalidates every safety rule, makes the targets active, and creates the permanent strategy-history entry without implying that trades have completed."]}],["$","pre",null,{"children":["$","code",null,{"children":"proposeStrategy(address[] newTokens, uint256[] newWeights, string rationale)\nsetNextStrategyRationale(string rationale)\nrebalance(address[] newTokens, uint256[] newWeights)\nactivatePendingStrategy()"}]}]]}]
18:["$","section",null,{"className":"docsSection","id":"trade-execution","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-scale","children":[["$","path","7g6ntu",{"d":"m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"}],["$","path","ijws7r",{"d":"m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"}],["$","path","1b0cd5",{"d":"M7 21h10"}],["$","path","108xh3",{"d":"M12 3v18"}],["$","path","3gwbw2",{"d":"M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Constrained restoration"}],["$","h2",null,{"children":"Trade execution and completion"}]]}]]}],["$","pre",null,{"children":["$","code",null,{"children":"executeRebalanceTrades(TradeInstruction[] trades)\n\ncompleteStrategicRebalance()"}]}],["$","p",null,{"children":"The manager is added to the executor allowlist automatically and may remove or restore their own execution permission. Any authorized executor may submit multiple partial trade batches. Every batch uses current constituents and approved adapters, returns output directly to the vault, satisfies oracle-valued slippage, turnover, NAV-loss, and exposure limits, and must move every constituent closer to target. Temporary approvals are exact and cleared after execution. A final successful trade batch automatically completes the strategic rebalance when all weights enter their completion bands. Explicit permissionless completion remains available when no trade is needed or prices naturally restore the portfolio."}]]}]
19:["$","section",null,{"className":"docsSection","id":"challenges","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-scale","children":[["$","path","7g6ntu",{"d":"m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"}],["$","path","ijws7r",{"d":"m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"}],["$","path","1b0cd5",{"d":"M7 21h10"}],["$","path","108xh3",{"d":"M12 3v18"}],["$","path","3gwbw2",{"d":"M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Permissionless accountability"}],["$","h2",null,{"children":"Weight bands and challenges"}]]}]]}],["$","p",null,{"children":["Each constituent has a wider challenge band and a narrower completion band around its active target. Anyone may call ",["$","code",null,{"children":"flagOutOfBand()"}],", but fresh approved prices must prove a real challenge-band breach. Invalid challenges revert."]}],["$","figure",null,{"className":"challengeLifecycle","aria-labelledby":"challenge-lifecycle-caption","children":[["$","div",null,{"className":"challengeLifecycleTrack","children":[["$","div",null,{"className":"challengeLifecycleNode","children":[["$","span",null,{"children":"Normal"}],["$","strong",null,{"children":"Fees accruing"}],["$","small",null,{"children":"Portfolio monitored against the wider challenge bands."}]]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}],["$","div",null,{"className":"challengeLifecycleNode active","children":[["$","span",null,{"children":"Challenged"}],["$","strong",null,{"children":"Five-day response"}],["$","small",null,{"children":"Older valid fees are crystallized; corrective trades remain available."}]]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}],["$","div",null,{"className":"challengeLifecycleNode overdue","children":[["$","span",null,{"children":"Overdue"}],["$","strong",null,{"children":"Fees suspended"}],["$","small",null,{"children":"Challenge-window fees are forfeited once; later fees stay suspended."}]]}]]}],["$","div",null,{"className":"challengeLifecycleReturns","children":[["$","span",null,{"children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-rotate-ccw","aria-hidden":"true","children":[["$","path","1357e3",{"d":"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"}],["$","path","1xhq8a",{"d":"M3 3v5h5"}],"$undefined"]}],"Timely restoration returns held-back fees"]}],["$","span",null,{"children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-rotate-ccw","aria-hidden":"true","children":[["$","path","1357e3",{"d":"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"}],["$","path","1xhq8a",{"d":"M3 3v5h5"}],"$undefined"]}],"Late restoration resumes only future fees"]}]]}],["$","figcaption",null,{"id":"challenge-lifecycle-caption","children":"Both restoration paths require fresh prices and weights inside the narrower completion bands."}]]}]]}]
1a:["$","section",null,{"className":"docsSection","id":"fee-accountability","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-receipt-text","children":[["$","path","q3az6g",{"d":"M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"}],["$","path","1l3xfs",{"d":"M14 8H8"}],["$","path","1fr5h0",{"d":"M16 12H8"}],["$","path","wsln4y",{"d":"M13 16H8"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Consequences and recovery"}],["$","h2",null,{"children":"Fee accountability"}]]}]]}],["$","p",null,{"children":"Deposits and proportional withdrawals stay enabled during ordinary weight challenges. If a globally revoked or zero-target asset is being retired, primary deposits pause until its exact balance reaches zero and it is removed. Its former weight is redistributed proportionally across the remaining targets, with integer rounding assigned deterministically so eligible targets still total exactly 100%. Withdrawals remain available. Natural price recovery and constrained manager or executor trades can restore the basket. Target redefinition, ownership transfer, or delayed fee crystallization cannot recover forfeited fees."}],["$","ul",null,{"className":"docsChecklist","children":[["$","li",null,{"children":"Opening a challenge first crystallizes every valid fee earned before the challenge start, so older fees cannot disappear."}],["$","li",null,{"children":"Before the deadline, timely restoration releases the full challenge-period fee interval to the manager and gives the challenger no reward."}],["$","li",null,{"children":"After the deadline, the first accrual path processes a one-time forfeiture capped at the recorded challenge deadline."}],["$","li",null,{"children":"Half of the forfeited challenge-window fees is credited to the original challenger as claimable reward shares."}],["$","li",null,{"children":"Later claims and accrual paths cannot increase the forfeiture or reward for the same challenge."}],["$","li",null,{"children":"No separate deadline-finalization transaction is required before the challenger claims."}]]}]]}]
1b:["$","section",null,{"className":"docsSection","id":"cooldown","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-clock3","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","polyline","1aq6pp",{"points":"12 6 12 12 16.5 12"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"One cooldown, one notice window"}],["$","h2",null,{"children":"Strategy timing"}]]}]]}],["$","p",null,{"children":"Deployment records the initial rationale and targets as completed strategy version zero, starting the first 14-day cooldown immediately. A manager can later propose new target weights only after 14 days have passed since the previous rebalance completed inside its target bands. The portfolio must still be inside those bands, with no active challenge or strategy change. A valid proposal then remains pending for a separate 48-hour holder exit window. Returning in-band early never shortens the cooldown: both the full 14 days and the in-band check must pass when the proposal is submitted."}],["$","pre",null,{"children":["$","code",null,{"children":"STRATEGY_CHANGE_COOLDOWN = 14 days\nSTRATEGY_ACTIVATION_DELAY = 48 hours\n\nnextStrategyChangeTime =\n  lastCompletedStrategyTimestamp + STRATEGY_CHANGE_COOLDOWN\n\ncanProposeStrategy =\n  block.timestamp >= nextStrategyChangeTime"}]}],["$","ul",null,{"className":"docsChecklist","children":[["$","li",null,{"children":"The first target proposal waits 14 days from vault creation."}],["$","li",null,{"children":"Later proposals wait 14 days from successful rebalance completion."}],["$","li",null,{"children":"Being in-band before that deadline does not make an early proposal valid."}],["$","li",null,{"children":"Active challenges and out-of-band portfolios block proposals."}],["$","li",null,{"children":"Current targets remain active throughout the 48-hour notice period."}],["$","li",null,{"children":"Failed proposals, failed trades, and partial trades do not update the timestamp."}],["$","li",null,{"children":"Challenges, staged rationales, fees, and role transfers do not reset it."}]]}]]}]
1c:["$","section",null,{"className":"docsSection","id":"safety","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-shield-check","children":[["$","path","oel41y",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"}],["$","path","dzmm74",{"d":"m9 12 2 2 4-4"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Managed by people, bounded by code"}],["$","h2",null,{"children":"Safety limits"}]]}]]}],["$","p",null,{"children":"Protocol-bounded controls become part of the vault's mandate. Target proposals and every partial trade batch are independently checked."}],["$","div",null,{"className":"docsTableWrap","children":["$","table",null,{"className":"docsTable","children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Protection"}],["$","th",null,{"children":"Enforcement"}]]}]}],["$","tbody",null,{"children":[["$","tr","Approved assets",{"children":[["$","td",null,{"children":"Approved assets"}],["$","td",null,{"children":"Every target asset must be present in the protocol asset registry."}]]}],["$","tr","Portfolio turnover",{"children":[["$","td",null,{"children":"Portfolio turnover"}],["$","td",null,{"children":"The oracle-valued amount in each partial batch cannot exceed the vault limit."}]]}],["$","tr","NAV loss",{"children":[["$","td",null,{"children":"NAV loss"}],["$","td",null,{"children":"Post-trade NAV cannot fall beyond the configured maximum loss."}]]}],["$","tr","Weight bands",{"children":[["$","td",null,{"children":"Weight bands"}],["$","td",null,{"children":"Wider challenge bands trigger accountability; narrower completion bands prove restoration."}]]}],["$","tr","Asset count",{"children":[["$","td",null,{"children":"Asset count"}],["$","td",null,{"children":"Portfolios cannot exceed the configured number of constituents."}]]}],["$","tr","Individual weights",{"children":[["$","td",null,{"children":"Individual weights"}],["$","td",null,{"children":"Maximum and minimum nonzero weights prevent invalid concentration and dust positions."}]]}],["$","tr","Oracle freshness",{"children":[["$","td",null,{"children":"Oracle freshness"}],["$","td",null,{"children":"Every valuation used for a rebalance must be recent enough for the vault's staleness bound."}]]}],["$","tr","Execution",{"children":[["$","td",null,{"children":"Execution"}],["$","td",null,{"children":"Every partial batch is atomic, uses approved adapters, clears exact approvals, and must reduce target distance."}]]}]]}]]}]}]]}]
1d:["$","section",null,{"className":"docsSection","id":"management-fees","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-receipt-text","children":[["$","path","q3az6g",{"d":"M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"}],["$","path","1l3xfs",{"d":"M14 8H8"}],["$","path","1fr5h0",{"d":"M16 12H8"}],["$","path","wsln4y",{"d":"M13 16H8"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Share-based accrual"}],["$","h2",null,{"children":"Management fees"}]]}]]}],["$","p",null,{"children":"Fees accrue lazily as shares rather than by removing portfolio assets. The growth formula is cadence-independent and calibrated to the displayed annual dilution. Deposits, redemptions, and fee changes settle the preceding interval first, so a new fee rate never applies retroactively. Missed challenge-window fees are skipped rather than minted; suspended intervals never accrue later."}]]}]
