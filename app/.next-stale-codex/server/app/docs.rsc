 price feeds."}]]}],["$","tr","FeeCollector",{"children":[["$","td",null,{"children":["$","code",null,{"children":"FeeCollector"}]}],["$","td",null,{"children":"Receives the protocol portion of creator-selected management fees."}]]}]]}]]}]}]]}]
