13:["$","section",null,{"className":"docsSection","id":"architecture","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-landmark","children":[["$","line","j8o0r",{"x1":"3","x2":"21","y1":"22","y2":"22"}],["$","line","10tf0k",{"x1":"6","x2":"6","y1":"18","y2":"11"}],["$","line","54lgf6",{"x1":"10","x2":"10","y1":"18","y2":"11"}],["$","line","380y",{"x1":"14","x2":"14","y1":"18","y2":"11"}],["$","line","1kevvc",{"x1":"18","x2":"18","y1":"18","y2":"11"}],["$","polygon","jkujk7",{"points":"12 2 20 7 4 7"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"System design"}],["$","h2",null,{"children":"Architecture"}]]}]]}],["$","p",null,{"children":"The factory creates minimal-proxy vaults. Each vault reads asset eligibility and oracle prices from registries, routes typed trades through a dedicated executor, and sends the protocol share of accrued fees to the fee collector. The factory and registries never custody a vault's portfolio."}],["$","div",null,{"className":"docsFlow","aria-label":"Protocol architecture","children":[["$","span",null,{"children":"Creator"}],["$","b",null,{"children":"Factory"}],["$","b",null,{"children":"Managed vault"}],["$","span",null,{"children":"Registries"}],["$","span",null,{"children":"Executor"}],["$","span",null,{"children":"Fee collector"}]]}],["$","div",null,{"className":"docsTableWrap","children":["$","table",null,{"className":"docsTable","children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Contract"}],["$","th",null,{"children":"Responsibility"}]]}]}],["$","tbody",null,{"children":[["$","tr","OTFFactory",{"children":[["$","td",null,{"children":["$","code",null,{"children":"OTFFactory"}]}],["$","td",null,{"children":"Creates deterministic vault clones, applies protocol-wide limits, and records vault ownership."}]]}],["$","tr","ManagedOTFVault",{"children":[["$","td",null,{"children":["$","code",null,{"children":"ManagedOTFVault"}]}],["$","td",null,{"children":"Custodies the portfolio, issues ERC-20 shares, accrues fees, and enforces portfolio rules."}]]}],["$","tr","RebalanceExecutor",{"children":[["$","td",null,{"children":["$","code",null,{"children":"RebalanceExecutor"}]}],["$","td",null,{"children":"Restricts execution to typed swaps through approved adapters."}]]}],["$","tr","AssetRegistry",{"children":[["$","td",null,{"children":["$","code",null,{"children":"AssetRegistry"}]}],["$","td",null,{"children":"Defines the asset universe a vault may hold."}]]}],["$","tr","OracleRegistry",{"children":[["$","td",null,{"children":["$","code",null,{"children":"OracleRegistry"}]}],["$","td",null,{"children":"Maps approved assets to fresh, Chainlink-compatible price feeds."}]]}],["$","tr","FeeCollector",{"children":[["$","td",null,{"children":["$","code",null,{"children":"FeeCollector"}]}],["$","td",null,{"children":"Receives the protocol portion of creator-selected management fees."}]]}]]}]]}]}]]}]
14:["$","section",null,{"className":"docsSection","id":"vault-lifecycle","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-boxes","children":[["$","path","lc1i9w",{"d":"M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"}],["$","path","1o9zyk",{"d":"m7 16.5-4.74-2.85"}],["$","path","va8pkn",{"d":"m7 16.5 5-3"}],["$","path","jnp8gn",{"d":"M7 16.5v5.17"}],["$","path","8zsnat",{"d":"M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"}],["$","path","8arw3v",{"d":"m17 16.5-5-3"}],["$","path","8rfmw",{"d":"m17 16.5 4.74-2.85"}],["$","path","k6z78m",{"d":"M17 16.5v5.17"}],["$","path","1xygjf",{"d":"M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"}],["$","path","1vbdud",{"d":"M12 8 7.26 5.15"}],["$","path","3rx089",{"d":"m12 8 4.74-2.85"}],["$","path","1io7kd",{"d":"M12 13.5V8"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"From creation to redemption"}],["$","h2",null,{"children":"Vault lifecycle"}]]}]]}],["$","h3",null,{"children":"Creation"}],["$","p",null,{"children":["The creator selects a manager, fee recipient, approved assets, target weights, fee, target-change cooldown, challenge and completion bands, grace period, and safety limits. The factory validates these parameters, deploys a deterministic clone, transfers the exact initial basket, and initializes the vault. Target weights must total ",["$","code",null,{"children":"10,000 bps"}],"."]}],["$","ol",null,{"className":"docsSteps","children":[["$","li",null,{"children":[["$","span",null,{"children":"01"}],["$","div",null,{"children":[["$","strong",null,{"children":"Validate"}],["$","p",null,{"children":"Factory hard caps, approved assets, weight bounds, and cooldown are checked."}]]}]]}],["$","li",null,{"children":[["$","span",null,{"children":"02"}],["$","div",null,{"children":[["$","strong",null,{"children":"Fund"}],["$","p",null,{"children":"The exact initial constituent balances move into the new vault."}]]}]]}],["$","li",null,{"children":[["$","span",null,{"children":"03"}],["$","div",null,{"children":[["$","strong",null,{"children":"Initialize"}],["$","p",null,{"children":"Rules, thesis version zero, and the creation-time cooldown baseline are stored."}]]}]]}],["$","li",null,{"children":[["$","span",null,{"children":"04"}],["$","div",null,{"children":[["$","strong",null,{"children":"Issue"}],["$","p",null,{"children":"Initial vault shares are minted to the manager."}]]}]]}]]}],["$","h3",null,{"children":"Deposits and redemptions"}],["$","p",null,{"children":"New shares require a proportional deposit of every current constituent. Required inputs round up to protect existing holders. Redemptions burn shares for a proportional basket and round outputs down. These operations do not reset the rebalance cooldown, and redemptions remain available if oracle-dependent actions are unavailable."}]]}]
15:["$","section",null,{"className":"docsSection","id":"portfolio","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-coins","children":[["$","circle","3yglwk",{"cx":"8","cy":"8","r":"6"}],["$","path","t5s6rm",{"d":"M18.09 10.37A6 6 0 1 1 10.34 18"}],["$","path","1obek4",{"d":"M7 6h1v4"}],["$","path","1rbuyh",{"d":"m16.71 13.88.7.71-2.82 2.82"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Assets, weights, and valuation"}],["$","h2",null,{"children":"Portfolio model"}]]}]]}],["$","p",null,{"children":"A portfolio stores its tracked asset addresses and target weights. Actual weights are derived from current balances and fresh oracle prices. NAV is the sum of each constituent's oracle-valued balance; NAV per share divides that value by the fee-adjusted share supply."}],["$","pre",null,{"children":["$","code",null,{"children":"asset value = token balance x oracle price\nportfolio NAV = sum(asset values)\nactual weight = asset value / portfolio NAV\nNAV per share = portfolio NAV / total share supply"}]}],["$","p",null,{"children":"Portfolio reads make targets, actual weights, balances, prices, and feed freshness independently inspectable. A thesis is versioned onchain metadata; amending it does not alter assets and does not count as a portfolio change."}]]}]
16:["$","section",null,{"className":"docsSection","id":"rebalancing","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-braces","children":[["$","path","ezmyqa",{"d":"M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"}],["$","path","e1hn23",{"d":"M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Targets, execution, and completion"}],["$","h2",null,{"children":"Rebalancing"}]]}]]}],["$","p",null,{"children":["Only the manager can call the standard ",["$","code",null,{"children":"rebalance"}]," function. It updates and locks constituents and target weights but executes no trades. The standard",["$","code",null,{"children":"Rebalanced"}]," event describes this target change, not successful restoration."]}],["$","pre",null,{"children":["$","code",null,{"children":"rebalance(address[] newTokens, uint256[] newWeights)\n\nexecuteRebalanceTrades(TradeInstruction[] trades)\n\ncompleteStrategicRebalance()"}]}],["$","p",null,{"children":"The manager or an authorized executor may submit multiple partial trade batches. Every batch uses current constituents and approved adapters, returns output directly to the vault, satisfies oracle-valued slippage, turnover, NAV-loss, and exposure limits, and must move every constituent closer to target. Temporary approvals are exact and cleared after execution."}]]}]
17:["$","section",null,{"className":"docsSection","id":"challenges","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-scale","children":[["$","path","7g6ntu",{"d":"m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"}],["$","path","ijws7r",{"d":"m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"}],["$","path","1b0cd5",{"d":"M7 21h10"}],["$","path","108xh3",{"d":"M12 3v18"}],["$","path","3gwbw2",{"d":"M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Permissionless accountability"}],["$","h2",null,{"children":"Weight bands and challenges"}]]}]]}],["$","p",null,{"children":["Each constituent has a wider challenge band and a narrower completion band around its active target. Anyone may call ",["$","code",null,{"children":"flagOutOfBand()"}],", but fresh approved prices must prove a real challenge-band breach. Invalid challenges revert."]}],["$","pre",null,{"children":["$","code",null,{"children":"Accruing\n  -> valid challenge or strategic target\nEscrowed\n  -> timely restoration: release manager shares\n  -> missed deadline: burn escrow\nSuspended\n  -> later restoration: resume only future fees"}]}],["$","p",null,{"children":"Deposits and proportional withdrawals stay enabled throughout. Natural price recovery and constrained manager or executor trades can both restore the basket. Target redefinition, ownership transfer, or delayed fee crystallization cannot recover forfeited fees."}]]}]
18:["$","section",null,{"className":"docsSection","id":"cooldown","children":[["$","div",null,{"className":"docsSectionHeading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-clock3","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","polyline","1aq6pp",{"points":"12 6 12 12 16.5 12"}],"$undefined"]}],["$","div",null,{"children":[["$","span",null,{"children":"Minimum seven days"}],["$","h2",null,{"children":"Strategy-change cooldown"}]]}]]}],["$","p",null,{"children":"Every vault waits at least seven days between strategic target proposals. Partial maintenance trades and completion remain available while the cooldown runs."}],["$","pre",null,{"children":["$","code",null,{"children":"MIN_REBALANCE_COOLDOWN = 7 days\nnextRebalanceTime =\n  lastRebalanceTimestamp + rebalanceCooldown\n\ncanRebalance =\n  block.timestamp >= nextRebalanceTime"}]}],["$","ul",null,{"className":"docsChecklist","children":[["$","li",null,{"children":"The first target proposal waits from the vault creation timestamp."}],["$","li",null,{"children":"Later proposals wait from the last accepted strategic target."}],["$","li",null,{"children":"Failed proposals do not update the timestamp."}],["$","li",null,{"children":"Trades, completion, challenges, fees, thesis amendments, and role transfers do not reset it."}]]}]]}]
