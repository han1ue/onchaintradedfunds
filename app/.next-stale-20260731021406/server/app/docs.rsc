completion bands prove restoration."}]]}],["$","tr","Asset count",{"children":[["$","td",null,{"children":"Asset count"}],["$","td",null,{"children":"Portfolios cannot exceed the configured number of constituents."}]]}],["$","tr","Individual weights",{"children":[["$","td",null,{"children":"Individual weights"}],["$","td",null,{"children":"Maximum and minimum nonzero weights prevent invalid concentration and dust positions."}]]}],["$","tr","Oracle freshness",{"children":[["$","td",null,{"children":"Oracle freshness"}],["$","td",null,{"children":"Every valuation used for a rebalance must be recent enough for the vault's staleness bound."}]]}],["$","tr","Execution",{"children":[["$","td",null,{"children":"Execution"}],["$","td",null,{"children":"Every partial batch is atomic, uses approved adapters, clears exact approvals, and must reduce target distance."}]]}]]}]]}]}]]}]
